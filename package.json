{
  "name": "@lucagiftzek/dsh-conductor",
  "version": "0.2.0",
  "description": "Keep long DeepSeek Harness chats cheap and under control: /new gives a chat a fresh context in place from a model-written handoff, /rewind takes the chat and the files the agent edited back to any prompt, plus an automatic compaction level, recovery after failed turns, /drop, pins, message versions, silent messages between chats and multi-chat orchestration, in one sidebar tab.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "cordis.patch.yml",
    "docs",
    "lib",
    "scripts",
    "!lib/**/*.map",
    "!lib/*.map",
    "!docs/**/*.png"
  ],
  "bin": {
    "dsh-post": "scripts/dsh-post"
  },
  "scripts": {
    "check": "for f in lib/*.js lib/context/*.js lib/conductor/*.js scripts/*.mjs test/*.mjs test/lab/*.mjs test/lab/probe/index.js; do node --check $f || exit 1; done && echo all files OK",
    "build": "node scripts/build.mjs",
    "test": "node test/run.mjs && node test/lossless.mjs && node test/client.mjs && node test/dual.mjs && node --test test/conductor.mjs && node --test test/contract.mjs",
    "test:e2e": "node --test --test-concurrency=1 test/e2e.mjs && node --test test/e2e-restart.mjs",
    "lab": "test/lab/lab.sh"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "jsdom": "^30.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "yaml": "^2.9.1"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.1-rc.5"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "dsh-better-sidebar"
      ]
    }
  },
  "keywords": [
    "agents",
    "checkpoints",
    "compaction",
    "context",
    "deepseek-harness",
    "dsh",
    "dsh-better-sidebar",
    "dsh-plugin",
    "handoff",
    "orchestration",
    "recovery",
    "rewind",
    "tokens"
  ],
  "author": {
    "name": "Luca Tzekos",
    "url": "https://jobopportunitiesapi.org"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucagiftzek/dsh-conductor.git"
  },
  "homepage": "https://github.com/lucagiftzek/dsh-conductor#readme",
  "bugs": {
    "url": "https://github.com/lucagiftzek/dsh-conductor/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
